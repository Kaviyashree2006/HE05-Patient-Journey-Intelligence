# Optional: Gemini API Key for LLM-powered extraction & grounded Q&A
# If omitted or offline, the system seamlessly uses the built-in Deterministic Clinical Pattern Extractor!
GEMINI_API_KEY=

# Optional: Database URL (default: SQLite local file database)
# For PostgreSQL: postgresql://user:password@localhost:5432/patient_journey
DATABASE_URL=sqlite:///./patient_journey.db

# Server port configuration
PORT=8000
HOST=127.0.0.1
